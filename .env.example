# Generate .env using python3 scripts/configure.py; no real keys belong in this file.
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
# Set true when using HTTPS. HTTP is for localhost/SSH tunnel setup only.
COOKIE_SECURE=false
# Public web signup. Existing accounts and invitation signup still work when false.
ALLOW_REGISTRATION=false
# Legacy initial default only. Workspace owners manage Cloud AI in Settings → AI.
# Standard conversation mode is still required; Private never calls cloud.
EXTERNAL_AI_ENABLED=false
OLLAMA_URL=http://ollama:11434/v1
# Legacy default for existing compatible providers. New Custom API URLs are set in the web UI.
COMPATIBLE_URL=
TELEGRAM_BOT_TOKEN=

# Optional email verification/recovery. Backend-only SMTP; TLS is required.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Concurrent AI jobs in separate workspaces; 1-4 (default 2).
AI_WORKERS=2
